# ==============================================================
# FOGLEAGUE — VARIABLES D'ENVIRONNEMENT PRODUCTION (100% GRATUIT)
# ==============================================================

# 1. Base de données PostgreSQL (Supabase — Gratuit sur https://supabase.com)
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=votre_cle_anon_publique
SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_ANON_KEY=votre_cle_anon_publique

# 2. Adresse du Backend API & Relais WebSocket
# En local : laisser vide ou http://localhost:3001
# En production : URL générée par Railway (ex: https://fogleague-production.up.railway.app)
VITE_API_URL=

# 3. Adresse du Frontend (pour la redirection Steam OpenID de retour)
# En local : http://localhost:5173
# En production : URL générée par Vercel (ex: https://fogleague.vercel.app)
FRONTEND_URL=http://localhost:5173

# 4. Port d'écoute du serveur Node.js (automatiquement défini par Railway / Render)
PORT=3001

# 5. Clé API Steam Web officielle (Optionnel — gratuit sur https://steamcommunity.com/dev/apikey)
# Permet d'extraire automatiquement le nombre réel d'heures jouées à Dead by Daylight (AppID 381210)
STEAM_API_KEY=

# ==============================================================
# FOGLEAGUE — VARIABLES D'ENVIRONNEMENT PRODUCTION (100% GRATUIT)
# ==============================================================

# 1. Base de données PostgreSQL (Supabase officiel)
VITE_SUPABASE_URL=https://mdgodogskkttbcnkvzwc.supabase.co
SUPABASE_URL=https://mdgodogskkttbcnkvzwc.supabase.co

# Clé publique pour le client (autorise uniquement la lecture)
VITE_SUPABASE_ANON_KEY=votre_cle_anon_publique
SUPABASE_ANON_KEY=votre_cle_anon_publique

# Clé secrète de gestion pour le backend (autorise l'écriture sécurisée)
SUPABASE_SERVICE_ROLE_KEY=votre_cle_secrete_service_role

# 2. Port d'écoute du serveur Node.js (automatiquement défini par Render)
PORT=10000
NODE_ENV=production

# 3. Adresse du site déployé sur Render (ex: https://fogleague.onrender.com)
FRONTEND_URL=

# 4. Clé API Steam Web officielle (Optionnel — gratuit sur https://steamcommunity.com/dev/apikey)
STEAM_API_KEY=
